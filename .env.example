# ── Admin Portal (Port 8080) ──
PORT=8080
LINE_REQUEST_TIMEOUT_SEC=10

# LINE Messaging API
LINE_ACCESS_TOKEN=
LINE_GROUP_ID=

# Google Sheet (legacy global, per-team config is in data/teams.json)
GOOGLE_SHEET_CSV_URL=

# App base URL (used in push notification links)
APP_BASE_URL=https://your-domain.example.com

# ── Web Push / Push Portal (Port 8082) ──
# Generate VAPID keys once with:  node -e "const w=require('web-push');console.log(w.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@your-domain.example.com

# Shared secret between Admin Portal and Push Portal (auto-generated on first setup)
PUSH_SECRET=

# Internal URL of the push-portal (used by Admin Portal to fire push notifications)
PUSH_PORTAL_URL=http://localhost:8082
